# Copy to .env and replace every value starting with "replace-" before the first start:
#   cp .env.example .env
# .env is git-ignored and must never be committed. Generate secrets with:
#   openssl rand -hex 32
# scripts/dev/bootstrap.sh refuses to start while a placeholder is still present.

# --- PostgreSQL (container superuser; the services connect as the same user) -----------
POSTGRES_USER=app_user
POSTGRES_PASSWORD=replace-with-local-db-password
# Password the services use. Must equal POSTGRES_PASSWORD.
DB_PASSWORD=replace-with-local-db-password

# --- Secrets (each at least 32 bytes) -----------------------------------------------------
# HMAC key that signs and verifies statement access tokens (statement-service, api-gateway, seeder).
STATEMENT_JWT_SECRET=replace-with-32-plus-random-bytes
STATEMENT_JWT_ISSUER=capitec-fin-platform
# HMAC key for aggregation-service tokens.
AGGREGATION_JWT_SECRET=replace-with-32-plus-random-bytes

# --- Truststore ----------------------------------------------------------------------------
# JKS truststore mounted into the image builds (corporate TLS inspection). Created by
# scripts/dev/generate-truststore.sh into the git-ignored .local/ directory. Point this at an
# existing truststore instead if you already have one.
TRUSTSTORE_FILE=./.local/truststore.jks

# --- Statement storage ----------------------------------------------------------------------
# Leave unset to use the Docker named volume "statement_storage" (recommended).
# To keep statement PDFs in a host folder instead, set an absolute path outside the repository:
# STATEMENT_STORAGE_HOST_DIR=/absolute/path/outside/the/repository

# --- Synthetic data seeding ----------------------------------------------------------------
# Number of synthetic customers the seeder ensures exist (minimum 50).
SEED_CUSTOMER_COUNT=60
# How long the seeder waits for fraud alerts and cases to appear after posting the triggers.
SEED_FRAUD_WAIT_SECONDS=180

# --- Service settings (defaults shown) -----------------------------------------------------
FRAUD_REEVALUATION_MODE=OFF
CASE_BACKFILL_FRAUD_CASES_ENABLED=false

# --- Host ports (change only if a port is already in use on your machine) -----------------
POSTGRES_HOST_PORT=5433
KAFKA_HOST_PORT=9092
API_GATEWAY_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
CUSTOMER_SERVICE_HOST_PORT=8081
ACCOUNT_SERVICE_HOST_PORT=8082
TRANSACTION_SERVICE_HOST_PORT=8083
CASE_SERVICE_HOST_PORT=8084
FRAUD_SERVICE_HOST_PORT=8085
NOTIFICATION_SERVICE_HOST_PORT=8086
STATEMENT_SERVICE_HOST_PORT=8087
AGGREGATION_SERVICE_HOST_PORT=8088
