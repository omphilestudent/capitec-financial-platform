# Copy to .env and fill in local values. .env is git-ignored and must never be committed.
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me-local-only
DB_PASSWORD=change-me-local-only
# Absolute host directory holding private statement PDFs. Must stay outside the repository.
STATEMENT_STORAGE_HOST_DIR=/absolute/path/to/private-statements
# HMAC secrets for development tokens (at least 32 bytes each). Replace in any shared environment.
STATEMENT_JWT_SECRET=replace-with-at-least-32-random-bytes
AGGREGATION_JWT_SECRET=replace-with-at-least-32-random-bytes
